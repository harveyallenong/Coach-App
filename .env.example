# ── Database ─────────────────────────────────────────────
# Runtime connection. On Vercel + Supabase you can leave DATABASE_URL/DIRECT_URL
# unset: the Supabase integration's POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING
# are used automatically. See docs/DEPLOYMENT.md.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coachbook"
# Direct/session connection for migrations (defaults to DATABASE_URL)
DIRECT_URL=""
# Optional PEM of the database CA to verify TLS (Supabase: Database settings → SSL)
DATABASE_CA_CERT=""
DATABASE_POOL_MAX="5"
# Used by integration tests (pnpm test:int)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coachbook_test"

# ── App ──────────────────────────────────────────────────
# Base URL for links in emails. On Vercel it defaults to the production domain.
APP_URL="http://localhost:3000"
# Comma-separated emails that are made admins on sign-in
ADMIN_EMAILS="admin@coachbook.local"
LOG_LEVEL="info"

# ── Auth.js ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST="true"
# Optional: Google sign-in (leave empty to hide the button)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email (SMTP — Mailpit locally; Resend via smtp.resend.com in prod) ──
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="CoachBook <no-reply@coachbook.local>"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coachbook_shadow"

# ── Seeding (deployments) ────────────────────────────────
# "true" = seed demo data during the Vercel build, only if the database is empty
SEED_ON_DEPLOY=""
# Take over demo coach Ana / demo client Bea with emails you can receive
SEED_COACH_EMAIL=""
SEED_CLIENT_EMAIL=""
